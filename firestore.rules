rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contents/{contentId} {
      allow read, write: if true;
    }
    match /comments/{commentId} {
      allow read, write: if true;
    }
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }
    match /siteSettings/{settingId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
