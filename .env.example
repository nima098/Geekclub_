# --- GeekClub Production Environment Configuration (.env) ---

# Admin key used to unlock the admin panel / protected API routes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY="CHANGE_ME_LONG_RANDOM_VALUE"

# API token of your CDN upload endpoint (upc.geekclub.ir). Rotate the old one - it was public on GitHub.
CDN_SECRET="CHANGE_ME_CDN_TOKEN"

# Key that must be appended to the RSS URL (?key=...). Different from the admin key.
RSS_FEED_KEY="CHANGE_ME_RSS_KEY"

# --- Database Configuration (PostgreSQL Relational Engine) ---
# When deployed on VPS with CloudPanel, create a PostgreSQL database and provide the connection string:
DATABASE_URL="postgresql://geekclub_user:your_password@127.0.0.1:5432/geekclub_db"

# Or configure individual PostgreSQL parameters:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=geekclub_user
# PGPASSWORD=your_password
# PGDATABASE=geekclub_db

# --- Google OAuth Credentials (geekclubir Project) ---
GOOGLE_OAUTH_CLIENT_ID="179971798076-05o98jtrbupk5kr49nsmlr37035b7hm0.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="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"

# --- Optional Integrations ---
APIFY_API_TOKEN=""
GEMINI_API_KEY=""
APP_URL="https://geekclub.ir"
