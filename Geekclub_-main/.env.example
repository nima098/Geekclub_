# --- Required secrets (NEVER commit real values; set them in your host's environment settings) ---

# Admin key used to unlock the admin panel / protected API routes. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY="CHANGE_ME_LONG_RANDOM_VALUE"

# API token of your CDN upload endpoint (upc.geekclub.ir). Rotate the old one - it was public on GitHub.
CDN_SECRET="CHANGE_ME_CDN_TOKEN"

# Key that must be appended to the RSS URL (?key=...). Different from the admin key.
RSS_FEED_KEY="CHANGE_ME_RSS_KEY"

# Optional integrations
APIFY_API_TOKEN=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
