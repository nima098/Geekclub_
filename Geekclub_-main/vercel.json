{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/feed",
      "destination": "/api/rss"
    },
    {
      "source": "/api/contents/:path*",
      "destination": "/api/contents"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
